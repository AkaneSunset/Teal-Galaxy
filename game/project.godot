; Engine configuration file.
; Teal Galaxy prototype: one project, two modes (Builder on phone, Explorer on PC).

config_version=5

[application]

config/name="Teal Galaxy"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
; Android's back button closes the open panel first; main.gd quits when nothing is open.
config/quit_on_go_back=false

[autoload]

Net="*res://net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; Sideways, either way up.
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Android needs ETC2/ASTC textures.
textures/vram_compression/import_etc2_astc=true
