{
  // The server's TypeScript (*.ts), type-checked with `npm run typecheck`. Node runs these files as
  // they are (type stripping, Node 22.18+), so they use only syntax that erases: no enums or
  // namespaces, and CommonJS require/module.exports like the JavaScript around them.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["*.ts", "bench/*.ts"]
}
